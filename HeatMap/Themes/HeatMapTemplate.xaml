<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:heatMap="clr-namespace:HeatMap">
    <Style TargetType="{x:Type heatMap:HeatMap}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type heatMap:HeatMap}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="10*" />
                            <RowDefinition Height="1*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>
                        <Canvas x:Name="PART_CoordinateSystemCanvas" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                Background="Beige" />
                        <Border Grid.Row="0" Grid.Column="1" Padding="5">
                            <heatMap:HeatMapVisualHost x:Name="PART_HeatMapVisualHost" />
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Background="Transparent" Padding="5,0">
                            <Canvas x:Name="PART_CoordinateXCanvas" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>